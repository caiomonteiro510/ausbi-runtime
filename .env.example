# Copy this file to ".env" and fill in the keys you plan to use.
# Never commit real keys, and never put them inside the vault — only the runtime env.

# Groq (OpenAI-compatible driver): https://console.groq.com
GROQ_API_KEY=gsk_...

# Anthropic (used for the higher-quality/on-demand profile):
ANTHROPIC_API_KEY=sk-ant-...
